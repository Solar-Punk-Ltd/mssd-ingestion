# SRS Configuration for MSSD Ingestion
#
# Receives SRT streams from OBS/FFmpeg, segments into HLS,
# and notifies the Node.js app via HTTP callbacks for each
# segment, stream start, and stream stop.
#
# Placeholders substituted by entrypoint.sh:
#   PASSPHRASE_PLACEHOLDER  → SRT_PASSPHRASE env var
#   WEBHOOK_PORT_PLACEHOLDER → WEBHOOK_PORT env var

listen              1935;
max_connections     1000;
daemon              off;

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

srt_server {
    enabled         on;
    listen          10080;
    latency         200;
    passphrase      PASSPHRASE_PLACEHOLDER;
    pbkeylen        16;
    tlpktdrop       on;
    tsbpdmode       on;
}

vhost __defaultVhost__ {
    srt {
        enabled     on;
    }

    hls {
        enabled         on;
        hls_path        ./objs/nginx/html;
        hls_fragment    1.5;
        hls_window      22.5;
        hls_ts_file     [app]/[stream]/[stream]-[seq].ts;
        hls_m3u8_file   [app]/[stream]/index.m3u8;
    }

    http_hooks {
        enabled         on;
        on_publish      http://localhost:WEBHOOK_PORT_PLACEHOLDER/api/v1/streams;
        on_unpublish    http://localhost:WEBHOOK_PORT_PLACEHOLDER/api/v1/streams;
        on_hls          http://localhost:WEBHOOK_PORT_PLACEHOLDER/api/v1/hls;
    }
}
